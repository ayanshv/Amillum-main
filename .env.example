# Desktop configuration: provider credentials belong only on the backend.
AMILLUM_ENV=production
# Only source development may opt into HTTP loopback using AMILLUM_ENV=development.
AMILLUM_AI_BACKEND_URL=
# Supabase project Settings → API. Use ONLY a publishable or legacy anon key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Apply supabase/migrations/*.sql in filename order.
# Include {{ .Token }} in the Supabase Reset Password email template.
# Sign in through Amillum. Refresh credentials use macOS Keychain.
# Never package a Supabase secret/service-role key.

# Optional local metadata detection tuning (no AI/network classification).
# Defaults calibrated against tests/test_legal_detection.py, not statistical probabilities.
AMILLUM_DETECTION_THRESHOLD=0.82
AMILLUM_DETECTION_COOLDOWN_SECONDS=120

# Proactive assistance: lower scores stay quiet; medium shows only the menu-bar beaver.
AMILLUM_INDICATOR_THRESHOLD=0.70
AMILLUM_SUGGESTION_THRESHOLD=0.90
AMILLUM_OFFER_INTERVAL_SECONDS=30
AMILLUM_DISMISSAL_SECONDS=300
